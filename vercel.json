{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "treasureacademyageva\\.com"
        }
      ],
      "destination": "https://www.treasureacademyageva.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "treasureacademyageva\\.vercel\\.app"
        }
      ],
      "destination": "https://www.treasureacademyageva.com/:path*",
      "permanent": true
    },
    {
      "source": "/portal",
      "destination": "/portal/login.html",
      "permanent": true
    },
    {
      "source": "/developer-operations.html",
      "destination": "/developer.html#overview",
      "permanent": true
    },
