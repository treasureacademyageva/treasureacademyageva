# Public/browser-safe Supabase configuration (use project-specific values only in deployment secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose this value to browser code or commit a real key.
SUPABASE_SECRET_KEY=

# Every feature remains fail-closed until its own staging acceptance and owner approval.
PORTAL_ENABLED=false
PORTAL_ACCOUNTS_ENABLED=false
PARENT_LINKING_ENABLED=false
PORTAL_REGISTRATION_ENABLED=false
PORTAL_OFFICE_ENABLED=false
WEBSITE_REQUESTS_ENABLED=false
PUBLIC_INFORMATION_ENABLED=false
PUBLIC_GRADUATE_WALL_ENABLED=false
ADMISSION_TRACKING_ENABLED=false
DEVELOPER_CONSOLE_ENABLED=false

# Manual admission OTP dispatch uses the registered phone and only WhatsApp or SMS.
# There is no SNS/AWS integration. Use independent random server-only values of at
# least 32 characters. Rotation invalidates undealt queue payloads/codes.
ADMISSION_OTP_HASH_PEPPER=
ADMISSION_OTP_ENCRYPTION_KEY=

# New private random value, at least 24 characters. Used only to HMAC rate-limit identifiers.
PORTAL_REGISTRATION_PEPPER=

# Legacy gateway scaffold remains dormant and is not an approved payment method.
MONNIFY_WEBHOOK_ENABLED=false
MONNIFY_OWNER_VERIFIED=false
