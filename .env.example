# Public/browser-safe Supabase configuration (use project-specific values only in deployment secrets)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Never expose this value to browser code or commit a real key.
SUPABASE_SECRET_KEY=

# Every feature remains fail-closed until its own staging acceptance and owner approval.
PORTAL_ENABLED=false
PORTAL_ACCOUNTS_ENABLED=false
PARENT_LINKING_ENABLED=false
PORTAL_REGISTRATION_ENABLED=false
PORTAL_ACCOUNT_CLAIM_ENABLED=false
PORTAL_OFFICE_ENABLED=false
WEBSITE_REQUESTS_ENABLED=false
PUBLIC_INFORMATION_ENABLED=false
PUBLIC_GRADUATE_WALL_ENABLED=false
ADMISSION_TRACKING_ENABLED=false
DEVELOPER_CONSOLE_ENABLED=false
# Temporary one-use first-password/recovery endpoint. Keep false until the
# owner privately issues an authorisation; return to false immediately after.
DEVELOPER_MANUAL_BOOTSTRAP_ENABLED=false
# Independent 32+ character server-only random value. It HMACs rotating network
# and phone rate-limit buckets; never expose it to the browser or reuse another key.
DEVELOPER_BOOTSTRAP_RATE_LIMIT_PEPPER=

# Run 6 governed Cloudinary media. Keep the feature gate false until the Run 5
# and Run 6 database migrations, private credentials and protected upload flow
# pass a separately authorised deployment acceptance. API secrets never enter
# browser code. The cloud, preset, folder and authenticated delivery type are
# deliberately pinned by the trusted server.
CMS_MEDIA_ENABLED=false
CLOUDINARY_CLOUD_NAME=ecbad9xj
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=treasure_academy_cms_signed
CLOUDINARY_ASSET_FOLDER=treasure-academy/cms/pending
CLOUDINARY_DELIVERY_TYPE=authenticated
CLOUDINARY_USAGE_WARNING_PERCENT=70

# Manual admission OTP dispatch uses the registered phone and only WhatsApp or SMS.
# There is no SNS/AWS integration. Use independent random server-only values of at
# least 32 characters. Rotation invalidates undealt queue payloads/codes.
ADMISSION_OTP_HASH_PEPPER=
ADMISSION_OTP_ENCRYPTION_KEY=

# Owner-approved staff account claim OTP. Use independent server-only random
# values of at least 32 characters; never reuse a password or provider token.
PORTAL_CLAIM_HASH_PEPPER=
PORTAL_CLAIM_OTP_ENCRYPTION_KEY=

# Optional Paragon Hub WhatsApp relay. It remains disabled until the separately
# deployed relay passes signature, replay, tenant and processor-boundary tests.
# The school sends only registered phone, short-lived OTP, expiry and delivery
# correlation. Pupil, class, result and payment data are prohibited.
PARAGON_OTP_RELAY_ENABLED=false
PARAGON_OTP_RELAY_URL=
# Base64 PKCS#8 Ed25519 private key. Paragon stores only the matching public key.
PARAGON_OTP_RELAY_PRIVATE_KEY_B64=
PARAGON_OTP_RELAY_KEY_ID=treasure-academy-ed25519-v1
PARAGON_OTP_RELAY_TENANT=treasure-academy

# New private random value, at least 24 characters. Used only to HMAC rate-limit identifiers.
PORTAL_REGISTRATION_PEPPER=

# Legacy gateway scaffold remains dormant and is not an approved payment method.
MONNIFY_WEBHOOK_ENABLED=false
MONNIFY_OWNER_VERIFIED=false
